{%- assign cta_title = title | default: 'Klaar om te starten?' -%}
{%- assign cta_text = text | default: 'Vertel kort wat je wilt bouwen. Binnen 1 werkdag hoor je van ons.' -%}
<section class="jr-section jr-section--muted">
  <div class="jr-container">
    <div class="jr-cta">
      <h2>{{ cta_title }}</h2>
      <p>{{ cta_text }}</p>
      <a class="jr-btn jr-btn--light" href="{% render 'offerte-url' %}">Offerte aanvragen</a>
    </div>
  </div>
</section>
