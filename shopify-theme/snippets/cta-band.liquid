{%- assign cta_title = title | default: 'Klaar om te starten?' -%}
{%- assign cta_text = text | default: 'Vertel kort wat je wilt bouwen. We reageren binnen één werkdag met een voorstel of een paar scherpe vragen.' -%}
<section class="jr-section jr-section--muted">
  <div class="jr-container">
    <div class="jr-cta">
      <h2>{{ cta_title }}</h2>
      <p>{{ cta_text }}</p>
      {%- if pages.offerte.title != blank -%}
        <a class="jr-btn jr-btn--light" href="{{ pages.offerte.url }}">Offerte aanvragen</a>
      {%- else -%}
        <a class="jr-btn jr-btn--light" href="/pages/contact">Offerte aanvragen</a>
      {%- endif -%}
    </div>
  </div>
</section>
