<section class="jr-section">
  <div class="jr-container">
    <div class="jr-contact-grid">
      <div>
        {% render 'section-heading',
          kicker: 'Contact',
          title: 'Stel een vraag',
          description: 'Twijfel je nog, of wil je eerst even praten? Mail of gebruik het formulier. Voor een prijs is de offertepagina handiger.'
        %}
        <dl class="jr-dl">
          <div>
            <dt>E-mail</dt>
            <dd><a href="mailto:info@jr-intelligence.com">info@jr-intelligence.com</a></dd>
          </div>
          <div>
            <dt>Reactietijd</dt>
            <dd>Binnen 1 werkdag</dd>
          </div>
          <div>
            <dt>Offerte</dt>
            <dd><a class="jr-link" href="{% render 'offerte-url' %}">Vraag een prijs aan</a></dd>
          </div>
        </dl>
      </div>
      {% render 'contact-form', default_interest: 'webshop', form_variant: 'contact' %}
    </div>
  </div>
</section>
