<a class="jr-product-card" href="{{ product.url }}">
  <div class="jr-product-card__media">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | escape }}"
        width="800"
        height="800"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'jr-product-card__placeholder' }}
    {%- endif -%}
    {%- unless product.available -%}
      <span class="jr-product-card__badge">Uitverkocht</span>
    {%- endunless -%}
  </div>
  <div class="jr-product-card__meta">
    <h3>{{ product.title }}</h3>
    <p>{{ product.price | money }}</p>
  </div>
</a>
