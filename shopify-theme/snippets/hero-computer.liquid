<div class="v2-devices-wrap">
  <svg class="v2-hero__line" viewBox="0 0 1552 1192" fill="none" aria-hidden="true">
    <path d="M520 230C800 50 1040 6 1180 48C1290 80 1235 108 1145 92" stroke="#059b60" stroke-width="1.75" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  </svg>
  <div class="v2-scene" data-jr-build>
    <div class="v2-imac">
      <div class="v2-imac__lid">
        <div class="v2-imac__screen">
          <div class="v2-scene-code" data-jr-code>
            <div class="v2-scene-code__bar">
              <span></span><span></span><span></span>
              <p>shop.js</p>
            </div>
            <pre class="v2-scene-code__body" data-jr-lines></pre>
          </div>
          <div class="v2-scene-shop">
            <div class="v2-scene-shop__bar">
              <strong>JR</strong>
              <p>Shop</p>
              <p>Over</p>
              <p>Contact</p>
              <i>2</i>
            </div>
            <div class="v2-scene-shop__view">
              <div class="v2-scene-shop__page">
                <div class="v2-scene-shop__fold">
                  <div class="v2-scene-shop__hero">
                    <img src="{{ 'scene-hero.jpg' | asset_url }}" alt="" width="900" height="600">
                    <div>
                      <p>Nieuwe collectie</p>
                      <span>Shop nu</span>
                    </div>
                  </div>
                  <div class="v2-scene-shop__grid">
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-jas.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Leren jas</p>
                      <b>€ 129</b>
                    </article>
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-tas.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Leren tas</p>
                      <b>€ 64</b>
                    </article>
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-shirt.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Shirt</p>
                      <b>€ 39</b>
                    </article>
                  </div>
                </div>
                <div class="v2-scene-shop__more">
                  <p>Bestsellers</p>
                  <div class="v2-scene-shop__grid">
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-schoen.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Laarzen</p>
                      <b>€ 89</b>
                    </article>
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-shopper.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Shopper</p>
                      <b>€ 24</b>
                    </article>
                    <article>
                      <div class="v2-scene-shop__photo">
                        <img src="{{ 'scene-jas.jpg' | asset_url }}" alt="" width="640" height="800">
                      </div>
                      <p>Zwarte jas</p>
                      <b>€ 119</b>
                    </article>
                  </div>
                </div>
              </div>
            </div>
            <div class="v2-scene-guides">
              <div class="v2-scene-ruler v2-scene-ruler--x"><span>0</span><span>40</span><span>80</span><span>120</span></div>
              <div class="v2-scene-ruler v2-scene-ruler--y"><span>0</span><span>40</span><span>80</span></div>
              <div class="v2-scene-tape v2-scene-tape--h"><b></b><em>142 cm</em></div>
              <div class="v2-scene-tape v2-scene-tape--v"><b></b><em>96 cm</em></div>
            </div>
          </div>
        </div>
      </div>
      <div class="v2-imac__chin"><span></span></div>
      <div class="v2-imac__neck"></div>
      <div class="v2-imac__foot"></div>
    </div>
  </div>
</div>
<script src="{{ 'hero-build.js' | asset_url }}" defer></script>
