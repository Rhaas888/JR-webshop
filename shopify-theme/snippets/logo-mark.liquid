{%- comment -%}
  Tijdelijke merken tot de echte logo's zijn geüpload.
{%- endcomment -%}
{%- case index -%}
  {%- when 0 -%}
    <svg viewBox="0 0 118 40" fill="none" aria-hidden="true">
      <path d="M4 20 10 8l6 12-6 12L4 20Z" fill="currentColor"/>
      <text x="24" y="25" fill="currentColor" font-family="Inter, sans-serif" font-size="14" font-weight="600" letter-spacing="2.2">NOORD</text>
    </svg>
  {%- when 1 -%}
    <svg viewBox="0 0 118 40" fill="none" aria-hidden="true">
      <text x="0" y="26" fill="currentColor" font-family="Georgia, serif" font-size="20" letter-spacing="2.4">LINDE</text>
    </svg>
  {%- when 2 -%}
    <svg viewBox="0 0 150 40" fill="none" aria-hidden="true">
      <path d="M14 7.2 20.2 20 14 32.8h4.2L22.4 23l4.2 9.8H31L24.6 20 31 7.2h-4.4L22.4 17 18.2 7.2H14Z" fill="currentColor"/>
      <text x="38" y="18" fill="currentColor" font-family="Inter, sans-serif" font-size="9" font-weight="700" letter-spacing="1.4">HAVEN</text>
      <text x="38" y="30" fill="currentColor" font-family="Inter, sans-serif" font-size="9" font-weight="500" letter-spacing="1.1">ATELIER</text>
    </svg>
  {%- when 3 -%}
    <svg viewBox="0 0 46 40" fill="none" aria-hidden="true">
      <circle cx="20" cy="20" r="12.5" stroke="currentColor" stroke-width="1.3"/>
      <text x="20" y="24" text-anchor="middle" fill="currentColor" font-family="Georgia, serif" font-size="13">M</text>
    </svg>
  {%- when 4 -%}
    <svg viewBox="0 0 128 40" fill="none" aria-hidden="true">
      <text x="0" y="16" fill="currentColor" font-family="Inter, sans-serif" font-size="7" font-weight="600" letter-spacing="2.2">BRASSERIE</text>
      <text x="0" y="32" fill="currentColor" font-family="Georgia, serif" font-size="16" letter-spacing="1.5">VELDE</text>
    </svg>
  {%- when 5 -%}
    <svg viewBox="0 0 132 40" fill="none" aria-hidden="true">
      <text x="0" y="27" fill="currentColor" font-family="Inter, sans-serif" font-size="18" font-weight="700" letter-spacing="0.4">KADE.</text>
    </svg>
  {%- when 6 -%}
    <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <rect x="8" y="8" width="22" height="22" rx="11" stroke="currentColor" stroke-width="1.2"/>
      <path d="M14.5 24.5c1.6-4.2 3.4-6.2 5.5-6.2 2.2 0 3.2 1.6 4.6 4.4" stroke="currentColor" stroke-width="1.2" fill="none"/>
      <path d="M16 16.2h6.2" stroke="currentColor" stroke-width="1.2"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 126 40" fill="none" aria-hidden="true">
      <text x="0" y="17" fill="currentColor" font-family="Inter, sans-serif" font-size="8" font-weight="600" letter-spacing="1.8">HUIS</text>
      <text x="0" y="31" fill="currentColor" font-family="Georgia, serif" font-size="14">Lindevaart</text>
    </svg>
{%- endcase -%}
