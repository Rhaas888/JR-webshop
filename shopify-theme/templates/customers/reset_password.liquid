<section class="jr-section">
  <div class="jr-container" style="max-width: 28rem;">
    <h1 class="jr-title">Nieuw wachtwoord</h1>
    {% form 'reset_customer_password', class: 'jr-form' %}
      <div class="jr-field">
        <label for="ResetPassword">Wachtwoord</label>
        <input id="ResetPassword" type="password" name="customer[password]" required>
      </div>
      <div class="jr-field">
        <label for="ResetPasswordConfirm">Bevestig wachtwoord</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" required>
      </div>
      <button type="submit" class="jr-btn jr-btn--primary jr-btn--full">Opslaan</button>
    {% endform %}
  </div>
</section>
