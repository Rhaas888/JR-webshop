<section class="jr-section">
  <div class="jr-container" style="max-width: 28rem;">
    <h1 class="jr-title">Account aanmaken</h1>
    {% form 'create_customer', class: 'jr-form' %}
      <div class="jr-field">
        <label for="RegisterFirst">Voornaam</label>
        <input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="jr-field">
        <label for="RegisterLast">Achternaam</label>
        <input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="jr-field">
        <label for="RegisterEmail">E-mail</label>
        <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="jr-field">
        <label for="RegisterPassword">Wachtwoord</label>
        <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="jr-btn jr-btn--primary jr-btn--full">Registreren</button>
    {% endform %}
  </div>
</section>
