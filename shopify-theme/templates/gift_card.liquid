{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cadeaubon · {{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <main class="page-width not-found">
      <h1>Cadeaubon</h1>
      <p>{{ gift_card.balance | money }}</p>
      <p>{{ gift_card.code | format_code }}</p>
    </main>
  </body>
</html>
