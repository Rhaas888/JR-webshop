<section class="jr-section">
  <div class="jr-container">
    <div class="jr-page-intro" style="padding-top: 0;">
      <p class="jr-kicker">Winkelwagen</p>
      <h1 class="jr-title">Jouw winkelwagen</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="jr-cart">
        <ul class="jr-cart__list">
          {%- for item in cart.items -%}
            <li class="jr-cart__row">
              <a class="jr-cart__media" href="{{ item.url }}">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="96"
                    height="96"
                  >
                {%- endif -%}
              </a>
              <div class="jr-cart__info">
                <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                {%- unless item.product.has_only_default_variant -%}
                  <p>{{ item.variant.title }}</p>
                {%- endunless -%}
                <p>{{ item.final_line_price | money }}</p>
                <a class="jr-link" href="{{ item.url_to_remove }}">Verwijderen</a>
              </div>
              <div class="jr-field jr-cart__qty">
                <label class="jr-visually-hidden" for="Updates-{{ item.key }}">Aantal</label>
                <input
                  id="Updates-{{ item.key }}"
                  type="number"
                  name="updates[{{ item.key }}]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Aantal {{ item.product.title }}"
                >
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="jr-cart__summary">
          <p>Totaal <strong>{{ cart.total_price | money }}</strong></p>
          <div class="jr-cart__actions">
            <button type="submit" name="update" class="jr-btn jr-btn--ghost">Bijwerken</button>
            <button type="submit" name="checkout" class="jr-btn jr-btn--primary">Afrekenen</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <p class="jr-lede">Je winkelwagen is leeg.</p>
      <a class="jr-btn jr-btn--primary" href="{{ routes.all_products_collection_url }}">Naar de shop</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Winkelwagen",
  "settings": []
}
{% endschema %}
