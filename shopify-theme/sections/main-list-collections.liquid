<section class="jr-section">
  <div class="jr-container">
    {% render 'section-heading', kicker: 'Collecties', title: 'Shop per collectie' %}
    {%- if collections.size > 0 -%}
      <div class="jr-product-grid">
        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' and collection.products_count == 0 -%}
            <a class="jr-product-card" href="{{ collection.url }}">
              <div class="jr-product-card__media">
                {%- if collection.featured_image -%}
                  <img
                    src="{{ collection.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.title | escape }}"
                    width="800"
                    height="800"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'jr-product-card__placeholder' }}
                {%- endif -%}
              </div>
              <div class="jr-product-card__meta">
                <h3>{{ collection.title }}</h3>
                <p>{{ collection.products_count }} producten</p>
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="jr-lede">Nog geen collecties. Producten die je toevoegt, verschijnen in de shop.</p>
      <a class="jr-btn jr-btn--primary" href="{{ routes.all_products_collection_url }}">Alle producten</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collectie-overzicht",
  "settings": []
}
{% endschema %}
