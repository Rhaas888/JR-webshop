<section class="jr-section">
  <div class="jr-container">
    {% render 'section-heading',
      kicker: 'Diensten',
      title: 'Webshop of app, verder niets',
      description: 'We bouwen webshops en apps. Niks anders. Daardoor blijft de prijs duidelijk en heb je direct contact met ons.'
    %}
    <div class="jr-cards jr-cards--2">
      <article class="jr-card jr-card--media">
        <div class="jr-card__media">
          <img src="{{ 'shop-still.png' | asset_url }}" alt="Productstilte voor een rustige webshop" width="800" height="600">
        </div>
        <div class="jr-card__body">
          <h3>Webshop laten bouwen</h3>
          <p class="jr-card__price">vanaf €499</p>
          <p>Een eigen shop: producten, checkout, beheer en een ontwerp dat bij je merk past.</p>
          <a class="jr-btn jr-btn--primary" href="/pages/webshop-laten-bouwen">Bekijk deze dienst</a>
        </div>
      </article>
      <article class="jr-card jr-card--media">
        <div class="jr-card__media">
          <img src="{{ 'app-desk.png' | asset_url }}" alt="Tablet met een overzichtelijk dashboard" width="800" height="600">
        </div>
        <div class="jr-card__body">
          <h3>App laten maken</h3>
          <p class="jr-card__price">vanaf €999</p>
          <p>Een app die past bij hoe jij werkt. Eerst een versie die je kunt gebruiken, daarna bouwen we verder.</p>
          <a class="jr-btn jr-btn--primary" href="{% render 'app-url' %}">Bekijk deze dienst</a>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Diensten",
  "settings": []
}
{% endschema %}
