{%- liquid
  assign help_link = section.settings.help_link
  assign websites_link = section.settings.websites_link
  assign automation_link = section.settings.automation_link
  assign apps_link = section.settings.apps_link
  if help_link == blank
    assign help_link = '/pages/contact'
  endif
  if websites_link == blank
    assign websites_link = '/pages/webshop-laten-bouwen'
  endif
  if automation_link == blank
    assign automation_link = '/pages/contact'
  endif
  if apps_link == blank
    assign apps_link = '/pages/app-laten-bouwen'
  endif
-%}

<section class="v2-services">
  <svg class="v2-services__curve v2-services__curve--right" viewBox="0 0 240 150" fill="none" aria-hidden="true">
    <path d="M8 28C70 8 150 36 232 138" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <svg class="v2-services__curve v2-services__curve--left" viewBox="0 0 150 180" fill="none" aria-hidden="true">
    <path d="M130 12C48 48 18 110 78 168" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>

  <div class="v2-services__inner page-width">
    <div class="v2-services__intro">
      <p class="v2-services__eyebrow"><span></span>{{ section.settings.eyebrow }}</p>
      <h2>
        {%- if section.settings.heading == 'Alles voor online groei en lokale vindbaarheid' -%}
          <span>Alles voor <b>online groei</b> en</span>
          <span><b>lokale vindbaarheid</b></span>
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      <div class="v2-services__lead">
        {%- if section.settings.text contains 'Wij bouwen en ontwikkelen digitale oplossingen die jouw bedrijf' -%}
          <p>Wij bouwen en ontwikkelen digitale oplossingen die jouw bedrijf <br>helpen groeien. Van websites en webshops tot automatiseringen <br>en krachtige apps.</p>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </div>
      <a class="v2-btn v2-services__cta" href="{{ help_link }}">
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="v2-services__cards">
      <article class="v2-services__card">
        <div class="v2-services__copy">
          <span class="v2-services__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="3" y="4.5" width="18" height="12" rx="2"/>
              <path d="M8 19.5h8M12 16.5v3"/>
            </svg>
          </span>
          <p class="v2-services__kicker">{{ section.settings.card_one_kicker }}</p>
          <h3>
            {%- if section.settings.card_one_title == 'Websites en webshops laten maken' -%}
              <span>Websites en</span>
              <span>webshops laten maken</span>
            {%- else -%}
              {{ section.settings.card_one_title }}
            {%- endif -%}
          </h3>
          <p class="v2-services__text">{{ section.settings.card_one_text }}</p>
          <a class="v2-services__more" href="{{ websites_link }}">
            {{ section.settings.more_label }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="v2-services__art" aria-hidden="true">
          <img src="{{ 'diensten-webshops.png' | asset_url }}" alt="" width="230" height="228">
        </div>
      </article>

      <article class="v2-services__card">
        <div class="v2-services__copy">
          <span class="v2-services__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M10.1 2.4h3.8l.5 2.1c.7.2 1.3.5 1.9.9l2-.9 2.7 2.7-1 2c.4.6.7 1.2.9 1.9l2.1.5v3.8l-2.1.5c-.2.7-.5 1.3-.9 1.9l1 2-2.7 2.7-2-.9c-.6.4-1.2.7-1.9.9l-.5 2.1h-3.8l-.5-2.1a7 7 0 0 1-1.9-.9l-2 .9-2.7-2.7 1-2a7 7 0 0 1-.9-1.9l-2.1-.5V9.6l2.1-.5c.2-.7.5-1.3.9-1.9l-1-2 2.7-2.7 2 .9c.6-.4 1.2-.7 1.9-.9l.5-2.1Zm1.9 6.2a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Z"/>
            </svg>
          </span>
          <p class="v2-services__kicker">{{ section.settings.card_two_kicker }}</p>
          <h3>
            {%- if section.settings.card_two_title == 'Processen slimmer maken' -%}
              <span>Processen</span>
              <span>slimmer maken</span>
            {%- else -%}
              {{ section.settings.card_two_title }}
            {%- endif -%}
          </h3>
          <p class="v2-services__text">{{ section.settings.card_two_text }}</p>
          <a class="v2-services__more" href="{{ automation_link }}">
            {{ section.settings.more_label }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="v2-services__art" aria-hidden="true">
          <img src="{{ 'diensten-automatisering.png' | asset_url }}" alt="" width="155" height="224">
        </div>
      </article>

      <article class="v2-services__card">
        <div class="v2-services__copy">
          <span class="v2-services__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="7" y="3" width="10" height="18" rx="2"/>
              <path d="M11 17.5h2"/>
            </svg>
          </span>
          <p class="v2-services__kicker">{{ section.settings.card_three_kicker }}</p>
          <h3>
            {%- if section.settings.card_three_title == 'Slimme apps op maat' -%}
              <span>Slimme apps</span>
              <span>op maat</span>
            {%- else -%}
              {{ section.settings.card_three_title }}
            {%- endif -%}
          </h3>
          <p class="v2-services__text">{{ section.settings.card_three_text }}</p>
          <a class="v2-services__more" href="{{ apps_link }}">
            {{ section.settings.more_label }}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="v2-services__art" aria-hidden="true">
          <img src="{{ 'diensten-apps.png' | asset_url }}" alt="" width="174" height="254">
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Diensten",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Onze diensten"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Alles voor online groei en lokale vindbaarheid"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Wij bouwen en ontwikkelen digitale oplossingen die jouw bedrijf helpen groeien. Van websites en webshops tot automatiseringen en krachtige apps.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop",
      "default": "Ontdek hoe we je helpen"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Knop-link"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Kaartlink",
      "default": "Meer informatie"
    },
    {
      "type": "text",
      "id": "card_one_kicker",
      "label": "Kaart 1 label",
      "default": "Websites & webshops"
    },
    {
      "type": "text",
      "id": "card_one_title",
      "label": "Kaart 1 titel",
      "default": "Websites en webshops laten maken"
    },
    {
      "type": "textarea",
      "id": "card_one_text",
      "label": "Kaart 1 tekst",
      "default": "Een snelle, professionele website of webshop die goed vindbaar is en bezoekers overtuigt om contact op te nemen."
    },
    {
      "type": "url",
      "id": "websites_link",
      "label": "Kaart 1 link"
    },
    {
      "type": "text",
      "id": "card_two_kicker",
      "label": "Kaart 2 label",
      "default": "Automatiseringen"
    },
    {
      "type": "text",
      "id": "card_two_title",
      "label": "Kaart 2 titel",
      "default": "Processen slimmer maken"
    },
    {
      "type": "textarea",
      "id": "card_two_text",
      "label": "Kaart 2 tekst",
      "default": "Wij automatiseren terugkerende taken en koppelen je systemen, zodat je tijd bespaart en efficiënter kunt werken."
    },
    {
      "type": "url",
      "id": "automation_link",
      "label": "Kaart 2 link"
    },
    {
      "type": "text",
      "id": "card_three_kicker",
      "label": "Kaart 3 label",
      "default": "Apps"
    },
    {
      "type": "text",
      "id": "card_three_title",
      "label": "Kaart 3 titel",
      "default": "Slimme apps op maat"
    },
    {
      "type": "textarea",
      "id": "card_three_text",
      "label": "Kaart 3 tekst",
      "default": "Van idee tot app in de store. Wij bouwen gebruiksvriendelijke en schaalbare apps die perfect aansluiten op jouw doelen."
    },
    {
      "type": "url",
      "id": "apps_link",
      "label": "Kaart 3 link"
    }
  ],
  "presets": [
    {
      "name": "Diensten"
    }
  ]
}
{% endschema %}
