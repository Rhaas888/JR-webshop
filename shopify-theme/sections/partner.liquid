{%- liquid
  assign services_link = section.settings.services_link
  assign contact_link = section.settings.contact_link
  if services_link == blank
    assign services_link = '/pages/diensten'
  endif
  if contact_link == blank
    assign contact_link = '/pages/contact'
  endif
-%}

<section class="v2-partner">
  <svg class="v2-partner__curve v2-partner__curve--left" viewBox="0 0 160 240" fill="none" aria-hidden="true">
    <path d="M20 230C70 180 130 120 70 8" stroke="#8fd4b8" stroke-width="1.6"/>
  </svg>
  <svg class="v2-partner__curve v2-partner__curve--right" viewBox="0 0 280 160" fill="none" aria-hidden="true">
    <path d="M10 28C90 8 170 36 280 118" stroke="#8fd4b8" stroke-width="1.6"/>
  </svg>

  <div class="v2-partner__inner page-width">
    <p class="v2-partner__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>
      <span>Jouw <b>{{ section.settings.word_custom }}</b> {{ section.settings.line_one }}</span>
      <span><b>{{ section.settings.word_auto }}</b> <b>{{ section.settings.word_smart }}</b> {{ section.settings.line_two }}</span>
      <span>{{ section.settings.line_three }}</span>
    </h2>
    <div class="v2-partner__lead">
      {%- if section.settings.text contains 'Wij bouwen digitale oplossingen die werken.' -%}
        <p>Wij bouwen digitale oplossingen die werken. <br>Van een professionele webshop tot een slimme app <br>of automatisering van je processen.</p>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </div>

    <div class="v2-partner__cards">
      <article class="v2-partner__card v2-partner__card--shop">
        <a class="v2-partner__chip" href="{{ services_link }}">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4.5h10l-.8 8.2a1 1 0 0 1-1 .8H4.8a1 1 0 0 1-1-.8L3 4.5Z"/><path d="M6 4.4V3.4A2 2 0 0 1 8 1.5a2 2 0 0 1 2 1.9v1"/></svg>
          {{ section.settings.chip }}
        </a>

        <div class="v2-partner__stage" aria-hidden="true">
          <div class="v2-mini">
            <div class="v2-mini__lid">
              <span class="v2-mini__cam"></span>
              <div class="v2-mini__screen">
                <aside>
                  <b>JR</b>
                  <span class="is-on">{{ 'partner.products' | t }}</span>
                  <span>{{ 'partner.orders' | t }}</span>
                  <span>{{ 'partner.collection' | t }}</span>
                </aside>
                <div class="v2-mini__main">
                  <p>{{ 'partner.collection' | t }}</p>
                  <div class="v2-mini__grid">
                    <article>
                      <span class="v2-mini__shot">
                        <svg viewBox="0 0 64 64"><path fill="none" stroke="#1b1d22" stroke-width="2.2" stroke-linecap="round" d="M22 26c0-6 2.2-9 5-9s5 3 5 9M34 26c0-6 2.2-9 5-9s5 3 5 9"/><path fill="#1b1d22" d="M18 28h28l-2.2 24H20.2L18 28Z"/></svg>
                      </span>
                      <b>{{ 'partner.bag' | t }}</b>
                      <small>€ 89,00</small>
                    </article>
                    <article>
                      <span class="v2-mini__shot">
                        <svg viewBox="0 0 64 64"><path fill="#1b1d22" d="M24 20h16c2 0 3 2 3 4v26c0 2-1 3-3 3H24c-2 0-3-1-3-3V24c0-2 1-4 3-4Z"/><path fill="none" stroke="#1b1d22" stroke-width="2.2" stroke-linecap="round" d="M22 30c-5 1-7 6-5 14M42 30c5 1 7 6 5 14"/><path fill="#2c2f35" d="M28 20c0-3 1.6-5 4-5s4 2 4 5v3h-8v-3Z"/></svg>
                      </span>
                      <b>{{ 'partner.backpack' | t }}</b>
                      <small>€ 129,00</small>
                    </article>
                    <article>
                      <span class="v2-mini__shot">
                        <svg viewBox="0 0 64 64"><path fill="#1b1d22" d="M14 28h36c2 0 3 1.4 3 3.2v14c0 2.4-1.6 4-4 4H15c-2.4 0-4-1.6-4-4v-14c0-1.8 1-3.2 3-3.2Z"/><path fill="#111317" d="M24 28v-5c0-2 1.4-3 3-3h10c1.6 0 3 1 3 3v5H24Z"/><path fill="none" stroke="#3a3d44" stroke-width="1.6" d="M22 34h20"/></svg>
                      </span>
                      <b>{{ 'partner.weekend' | t }}</b>
                      <small>€ 149,00</small>
                    </article>
                  </div>
                </div>
              </div>
            </div>
            <div class="v2-mini__deck"></div>
          </div>

          <div class="v2-handset">
            <div class="v2-handset__screen">
              <div class="v2-handset__status"><b>9:41</b><span></span></div>
              <span class="v2-handset__notch"></span>
              <div class="v2-handset__hero">
                <svg viewBox="0 0 160 210" preserveAspectRatio="xMidYMid slice">
                  <rect width="160" height="210" fill="#8b949c"/>
                  <rect width="34" height="210" fill="#747d86"/>
                  <rect x="126" width="34" height="210" fill="#667079"/>
                  <ellipse cx="78" cy="62" rx="15" ry="17" fill="#c99672"/>
                  <path fill="#16181c" d="M46 210c3-46 12-74 20-92 5-12 14-16 24-12 7 3 12 14 16 26 5 16 12 42 16 78H46Z"/>
                  <path fill="#0d0f12" d="M62 118h34l-3 58H65l-3-58Z"/>
                  <path fill="none" stroke="#0d0f12" stroke-width="3" stroke-linecap="round" d="M72 118c0-8 4-12 9-12s9 4 9 12"/>
                </svg>
                <div class="v2-handset__copy">
                  <strong>{{ 'partner.new_collection' | t }}</strong>
                  <small>{{ 'partner.bags_line' | t }}</small>
                </div>
              </div>
              <div class="v2-handset__row">
                <article>
                  <span class="v2-mini__shot">
                    <svg viewBox="0 0 64 64"><path fill="none" stroke="#1b1d22" stroke-width="2.2" stroke-linecap="round" d="M22 26c0-6 2.2-9 5-9s5 3 5 9M34 26c0-6 2.2-9 5-9s5 3 5 9"/><path fill="#1b1d22" d="M18 28h28l-2.2 24H20.2L18 28Z"/></svg>
                  </span>
                  <b>{{ 'partner.bag' | t }}</b>
                  <small>€ 89,00</small>
                </article>
                <article>
                  <span class="v2-mini__shot">
                    <svg viewBox="0 0 64 64"><path fill="#1b1d22" d="M24 20h16c2 0 3 2 3 4v26c0 2-1 3-3 3H24c-2 0-3-1-3-3V24c0-2 1-4 3-4Z"/><path fill="#2c2f35" d="M28 20c0-3 1.6-5 4-5s4 2 4 5v3h-8v-3Z"/></svg>
                  </span>
                  <b>{{ 'partner.backpack' | t }}</b>
                  <small>€ 129,00</small>
                </article>
              </div>
            </div>
          </div>
        </div>

        <div class="v2-partner__sheet">
          <div>
            <h3>{{ section.settings.card_one_title }}</h3>
            <p>{{ section.settings.card_one_text }}</p>
            <ul>
              <li>{{ section.settings.point_one }}</li>
              <li>{{ section.settings.point_two }}</li>
              <li>{{ section.settings.point_three }}</li>
            </ul>
          </div>
          <a class="v2-partner__go" href="{{ services_link }}" aria-label="{{ 'partner.view' | t }}">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        </div>
      </article>

      <article class="v2-partner__card">
        <span class="v2-partner__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="2.2"/><circle cx="15.2" cy="9.4" r="1.8"/><path d="M4.8 17.2c.6-2.2 2.2-3.4 4.2-3.4s3.6 1.2 4.2 3.4"/><path d="M13.2 14.2c1.4-.5 2.8-.2 3.8 1.2"/></svg>
        </span>
        <h3>{{ section.settings.card_two_title }}</h3>
        <blockquote>
          <p>“{{ section.settings.quote }}”</p>
        </blockquote>
        <div class="v2-partner__faces" aria-hidden="true">
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#d9c3ae"/><circle cx="20" cy="16" r="6" fill="#e7c8a4"/><path d="M8 34c2-7 7-10 12-10s10 3 12 10" fill="#3d4a62"/></svg>
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#c9b7a4"/><circle cx="20" cy="16" r="6" fill="#c48b62"/><path d="M9 34c2-6 6-9 11-9s9 3 11 9" fill="#243044"/><path d="M14 15c1-4 4-6 6-6s5 2 6 6" fill="#2a211c"/></svg>
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#d5c4b4"/><circle cx="20" cy="16" r="6" fill="#e4b48a"/><path d="M8 35c2-7 7-11 12-11s10 4 12 11" fill="#1f6b4a"/><path d="M14 12c1.2-3 3.4-4 6-4s4.6 1 6 4c-1.4 1-3.2 1.4-6 1.4s-4.6-.4-6-1.4Z" fill="#1c1c1c"/></svg>
          <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#e4d3c4"/><circle cx="20" cy="17" r="6" fill="#f0d0b4"/><path d="M8 34c2-6 6-9 12-9s10 3 12 9" fill="#f2f2f2"/><path d="M12 16c2-6 6-8 8-8s6 2 8 8c-2 1-4 1-8 1s-6 0-8-1Z" fill="#6a3b24"/></svg>
        </div>
        <p class="v2-partner__by">— {{ section.settings.quote_by }}</p>
      </article>

      <article class="v2-partner__card">
        <span class="v2-partner__icon v2-partner__icon--round" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M16.6 8.1A5.4 5.4 0 0 0 8 9.2"/><path d="M8 6.6V9.4h2.7"/><path d="M7.4 15.9A5.4 5.4 0 0 0 16 14.8"/><path d="M16 17.4v-2.8h-2.7"/></svg>
          <b>360°</b>
        </span>
        <h3>{{ section.settings.card_three_title }}</h3>
        <p class="v2-partner__copy">
          {%- if section.settings.card_three_text == 'Van strategie en ontwikkeling tot hosting. Wij regelen alles van A tot Z.' -%}
            Van strategie en ontwikkeling <br>tot hosting. Wij regelen alles <br>van A tot Z.
          {%- else -%}
            {{ section.settings.card_three_text }}
          {%- endif -%}
        </p>
        <a class="v2-partner__place" href="{{ contact_link }}" aria-label="{{ 'partner.contact' | t }}">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14s4.5-4 4.5-7A4.5 4.5 0 0 0 8 2.5 4.5 4.5 0 0 0 3.5 7C3.5 10 8 14 8 14Z"/><circle cx="8" cy="7" r="1.4"/></svg>
          <span>
            <small>{{ section.settings.place_label }}</small>
            <b>{{ section.settings.place }}</b>
          </span>
          <i aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </i>
        </a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maatwerk",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine tekst", "default": "Onze klanten" },
    { "type": "text", "id": "word_custom", "label": "Groen woord 1", "default": "maatwerk" },
    { "type": "text", "id": "line_one", "label": "Regel 1", "default": "partner voor meer" },
    { "type": "text", "id": "word_auto", "label": "Groen woord 2", "default": "automatisering," },
    { "type": "text", "id": "word_smart", "label": "Groen woord 3", "default": "slimme" },
    { "type": "text", "id": "line_two", "label": "Regel 2", "default": "apps en krachtige" },
    { "type": "text", "id": "line_three", "label": "Regel 3", "default": "webshops" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Wij bouwen digitale oplossingen die werken. Van een professionele webshop tot een slimme app of automatisering van je processen.</p>"
    },
    { "type": "text", "id": "chip", "label": "Label op de kaart", "default": "Webshops" },
    { "type": "text", "id": "card_one_title", "label": "Kaart 1 titel", "default": "Alles op maat gebouwd." },
    { "type": "text", "id": "card_one_text", "label": "Kaart 1 tekst", "default": "Voor jouw bakkerij, werkplaats of kantoor." },
    { "type": "text", "id": "point_one", "label": "Punt 1", "default": "Webshops" },
    { "type": "text", "id": "point_two", "label": "Punt 2", "default": "Apps" },
    { "type": "text", "id": "point_three", "label": "Punt 3", "default": "Automatiseringen" },
    { "type": "url", "id": "services_link", "label": "Link naar diensten" },
    { "type": "text", "id": "card_two_title", "label": "Kaart 2 titel", "default": "100% Maatwerk" },
    { "type": "textarea", "id": "quote", "label": "Citaat", "default": "Binnen enkele weken hadden we een app en alles naadloos gekoppeld. Prachtig resultaat." },
    { "type": "text", "id": "quote_by", "label": "Naam bij citaat", "default": "Bakkerij de Jong" },
    { "type": "text", "id": "card_three_title", "label": "Kaart 3 titel", "default": "360° Ondersteuning" },
    { "type": "textarea", "id": "card_three_text", "label": "Kaart 3 tekst", "default": "Van strategie en ontwikkeling tot hosting. Wij regelen alles van A tot Z." },
    { "type": "text", "id": "place_label", "label": "Plaats label", "default": "Actief vanuit" },
    { "type": "text", "id": "place", "label": "Plaats", "default": "Amsterdam" },
    { "type": "url", "id": "contact_link", "label": "Link naar contact" }
  ],
  "presets": [
    { "name": "Maatwerk" }
  ]
}
{% endschema %}
