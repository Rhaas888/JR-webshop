<section class="jr-section">
  <div class="jr-container" style="max-width: 36rem; padding-top: 80px;">
    <p><strong>JR</strong> Intelligence</p>
    <h1 class="jr-title" style="margin-top: 24px;">Opening soon</h1>
    <p class="jr-lede">De site staat bijna live. Zet wachtwoordbeveiliging uit in Shopify als je hem wilt openzetten.</p>
    {% form 'storefront_password', class: 'jr-form' %}
      <div class="jr-field">
        <label for="Password">Wachtwoord</label>
        <input type="password" name="password" id="Password">
      </div>
      <button type="submit" class="jr-btn jr-btn--primary">Enter</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Wachtwoord"
}
{% endschema %}
