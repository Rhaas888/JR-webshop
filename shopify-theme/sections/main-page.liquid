{%- if page.handle == 'offerte' -%}
  {% render 'contact-page', view_setting: 'offerte' %}
{%- elsif page.handle == 'over-ons' -%}
  {% render 'about-page' %}
{%- else -%}
  <section class="main-page page-width">
    <h1>{{ page.title }}</h1>

    {% if page.content != blank %}
      <div>{{ page.content }}</div>
    {% endif %}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Pagina",
  "settings": []
}
{% endschema %}
