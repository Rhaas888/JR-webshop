{%- capture offerte_url -%}{% render 'offerte-url' %}{%- endcapture -%}
{%- assign offerte_url = offerte_url | strip -%}
{%- capture app_url -%}{% render 'app-url' %}{%- endcapture -%}
{%- assign app_url = app_url | strip -%}
<header class="jr-header" data-header>
  <div class="jr-container jr-header__inner">
    <a href="{{ routes.root_url }}" class="jr-logo">
      <img
        class="jr-logo__img jr-logo__img--light"
        src="{{ 'logo-jr.png' | asset_url }}"
        alt="JR Intelligence"
        width="146"
        height="73"
      >
      <img
        class="jr-logo__img jr-logo__img--dark"
        src="{{ 'logo-jr-black.png' | asset_url }}"
        alt=""
        width="146"
        height="73"
      >
    </a>

    <nav class="jr-nav" aria-label="Hoofdmenu">
      <a href="/pages/webshop-laten-bouwen">Webshop</a>
      <a href="{{ app_url }}">App</a>
      <a href="/pages/prijzen">Prijzen</a>
      <a href="/pages/over-ons">Over ons</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="jr-header__actions">
      <a class="jr-btn jr-btn--primary jr-header__cta" href="{{ offerte_url }}">Offerte aanvragen</a>
      <button
        type="button"
        class="jr-menu-btn"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="MobileMenu"
        aria-label="Menu openen"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="jr-drawer" id="MobileMenu" data-menu>
  <div class="jr-drawer__backdrop" data-menu-close></div>
  <div class="jr-drawer__panel">
    <p class="jr-drawer__title">
      <img src="{{ 'logo-jr-black.png' | asset_url }}" alt="JR Intelligence" width="146" height="73">
    </p>
    <nav aria-label="Mobiel menu">
      <a href="/pages/webshop-laten-bouwen" data-menu-close>Webshop</a>
      <a href="{{ app_url }}" data-menu-close>App</a>
      <a href="/pages/prijzen" data-menu-close>Prijzen</a>
      <a href="/pages/over-ons" data-menu-close>Over ons</a>
      <a href="/pages/contact" data-menu-close>Contact</a>
      <hr class="jr-drawer__rule">
      <a href="/pages/onderhoud" data-menu-close>Onderhoud</a>
      <a href="/pages/ervaringen" data-menu-close>Ervaringen</a>
      <a href="/pages/faq" data-menu-close>FAQ</a>
      <a href="{{ offerte_url }}" data-menu-close>Offerte</a>
      <a class="jr-btn jr-btn--primary" href="{{ offerte_url }}">Offerte aanvragen</a>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
