<header class="site-header">
  <div class="site-header__inner page-width">
    <a class="site-header__brand" href="{{ routes.root_url }}">
      {{ shop.name }}
    </a>

    {% if section.settings.menu != blank %}
      <nav class="site-header__nav" aria-label="{{ 'header.navigation' | t }}">
        <ul>
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <a class="site-header__cart" href="{{ routes.cart_url }}">
      {{ 'header.cart' | t }} ({{ cart.item_count }})
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
