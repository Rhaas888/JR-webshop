<header class="site-header" data-header>
  <div class="site-header__inner page-width">
    <a class="site-header__logo" href="{{ routes.root_url }}">
      <img
        class="site-header__mark site-header__mark--dark"
        src="{{ 'logo-jr-black.png' | asset_url }}"
        alt="JR Intelligence"
        width="146"
        height="73"
      >
      <img
        class="site-header__mark site-header__mark--light"
        src="{{ 'logo-jr.png' | asset_url }}"
        alt=""
        width="146"
        height="73"
      >
    </a>

    <nav class="site-header__nav" aria-label="{{ 'header.navigation' | t }}">
      <a href="{{ routes.root_url }}" {% if request.page_type == 'index' %}aria-current="page"{% endif %}>{{ 'header.home' | t }}</a>
      <a href="/pages/diensten">{{ 'header.services' | t }}</a>
      <a href="/pages/over-ons">{{ 'header.about' | t }}</a>
      <a href="/pages/contact">{{ 'header.contact' | t }}</a>
    </nav>

    <a class="site-header__cta" href="/pages/contact">
      {{ 'header.start' | t }}
      <span aria-hidden="true">→</span>
    </a>

    <button
      class="site-header__menu"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="MobileMenu"
      aria-label="{{ 'header.open_menu' | t }}"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="site-menu" id="MobileMenu" data-menu>
  <button class="site-menu__backdrop" type="button" data-menu-close aria-label="{{ 'header.close_menu' | t }}"></button>
  <nav class="site-menu__panel" aria-label="{{ 'header.navigation' | t }}">
    <a href="{{ routes.root_url }}" data-menu-close>{{ 'header.home' | t }}</a>
    <a href="/pages/diensten" data-menu-close>{{ 'header.services' | t }}</a>
    <a href="/pages/over-ons" data-menu-close>{{ 'header.about' | t }}</a>
    <a href="/pages/contact" data-menu-close>{{ 'header.contact' | t }}</a>
    <a class="site-header__cta" href="/pages/contact" data-menu-close>
      {{ 'header.start' | t }}
      <span aria-hidden="true">→</span>
    </a>
  </nav>
</div>

<script src="{{ 'header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
