<section class="v2-faq">
  <svg class="v2-faq__curve v2-faq__curve--right" viewBox="0 0 240 150" fill="none" aria-hidden="true">
    <path d="M8 28C70 8 150 36 232 138" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <svg class="v2-faq__curve v2-faq__curve--left" viewBox="0 0 150 180" fill="none" aria-hidden="true">
    <path d="M130 12C48 48 18 110 78 168" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <div class="page-width">
    <header class="v2-faq__head">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </header>
    <div class="v2-faq__list">
      {%- for block in section.blocks -%}
        <details class="v2-faq__item" {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="v2-faq__plus" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M8 3.2v9.6"/><path d="M3.2 8h9.6"/></svg>
            </span>
          </summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veelgestelde vragen",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Veelgestelde vragen"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Alles wat je wilt weten over samenwerken met ons."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Vraag",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Vraag"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Antwoord"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veelgestelde vragen"
    }
  ]
}
{% endschema %}
