{%- capture app_href -%}{% render 'app-url' %}{%- endcapture -%}
{%- assign app_href = app_href | strip -%}

<section class="jr-showcase">
  <div class="jr-showcase__media" aria-hidden="true">
    <img
      class="jr-showcase__collage"
      src="{{ 'hero-collage.png' | asset_url }}"
      alt=""
      width="1920"
      height="1080"
    >
  </div>

  <div class="jr-container jr-showcase__inner">
    <div class="jr-showcase__copy">
      <h1>
        {{ section.settings.line1 }}<br>
        <span class="jr-scribble">{{ section.settings.highlight }}{% render 'scribble' %}</span>
        {%- if section.settings.line3 != blank -%}
          <br>{{ section.settings.line3 }}
        {%- endif -%}
      </h1>
      <p class="jr-showcase__lede">
        Jouw bedrijf is uniek. Je webshop mag dat ook zijn.<br>
        Webshops en apps volledig op maat.
      </p>
      <div class="jr-showcase__actions">
        <a class="jr-btn jr-btn--primary jr-btn--lg" href="/pages/webshop-laten-bouwen">Webshop</a>
        <a class="jr-btn jr-btn--primary jr-btn--lg" href="{{ app_href }}">App</a>
      </div>
    </div>

    {% render 'hero-video' %}
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "text",
      "id": "line1",
      "label": "Regel 1",
      "default": "Webshop of app"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Scribble-woord",
      "default": "op maat"
    },
    {
      "type": "text",
      "id": "line3",
      "label": "Regel 3",
      "default": "voor jouw bedrijf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Tekst",
      "default": "Jouw bedrijf is uniek. Je webshop mag dat ook zijn. Webshops en apps volledig op maat."
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
