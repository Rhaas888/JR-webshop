{%- capture app_href -%}{% render 'app-url' %}{%- endcapture -%}
{%- assign app_href = app_href | strip -%}

<section class="jr-showcase">
  <div class="jr-showcase__media" aria-hidden="true">
    <img
      class="jr-showcase__collage"
      src="{{ 'hero-collage.png' | asset_url }}"
      alt=""
      width="1920"
      height="1080"
    >
  </div>

  <div class="jr-container jr-showcase__inner">
    <div class="jr-showcase__copy">
      <h1>
        {{ section.settings.line1 }}<br>
        <span class="jr-scribble">{{ section.settings.highlight }}{% render 'scribble' %}</span>
        {%- if section.settings.line3 != blank -%}
          <br>{{ section.settings.line3 }}
        {%- endif -%}
      </h1>
      {%- assign lede = section.settings.description | strip -%}
      {%- assign lede_old = 'Wij bouwen overzichtelijke webshops en apps die passen bij hoe jullie werken. Strak ontwerp, heldere prijzen, korte lijnen.' -%}
      {%- if lede == blank or lede == lede_old -%}
        {%- assign lede = 'Wij ontwerpen en bouwen webshops en applicaties die aansluiten op de werkwijze van uw organisatie. Doordacht ontwerp, betrouwbare techniek en een vaste prijs voordat we starten.' -%}
      {%- endif -%}
      <p class="jr-showcase__lede">{{ lede }}</p>
      <div class="jr-showcase__actions">
        <a class="jr-btn jr-btn--primary jr-btn--lg" href="/pages/webshop-laten-bouwen">Webshop</a>
        <a class="jr-btn jr-btn--ghost jr-btn--lg" href="{{ app_href }}">App</a>
      </div>
    </div>

    <div class="jr-showcase__devices">
      <img
        src="{{ 'hero-devices.png' | asset_url }}"
        alt="Webshop en app op laptop, telefoon en iPad"
        width="1920"
        height="1080"
      >
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "text",
      "id": "line1",
      "label": "Regel 1",
      "default": "Webshop of app"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Scribble-woord",
      "default": "op maat"
    },
    {
      "type": "text",
      "id": "line3",
      "label": "Regel 3",
      "default": "voor jouw bedrijf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Tekst",
      "default": "Wij ontwerpen en bouwen webshops en applicaties die aansluiten op de werkwijze van uw organisatie. Doordacht ontwerp, betrouwbare techniek en een vaste prijs voordat we starten."
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
