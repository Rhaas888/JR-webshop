<section class="jr-trust">
  <div class="jr-container">
    <div class="jr-trust__intro">
      <p class="jr-kicker">Samenwerken</p>
      <h2>Dit kun je van ons verwachten</h2>
    </div>
    <div class="jr-trust__grid">
      <article class="jr-trust__card">
        <div class="jr-trust__top">
          <span class="jr-trust__index">01</span>
          <span class="jr-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a8 8 0 0 1-8 8H7l-4 3V12a8 8 0 1 1 18 0Z" />
            </svg>
          </span>
        </div>
        <p class="jr-trust__title">Snel contact</p>
        <p class="jr-trust__text">Binnen 1 werkdag hoor je van ons.</p>
      </article>
      <article class="jr-trust__card">
        <div class="jr-trust__top">
          <span class="jr-trust__index">02</span>
          <span class="jr-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.5 3H4v8.5L13.3 20.8a1.5 1.5 0 0 0 2.1 0l5.4-5.4a1.5 1.5 0 0 0 0-2.1L12.5 3Z" />
              <circle cx="7.5" cy="7.5" r="1.2" />
            </svg>
          </span>
        </div>
        <p class="jr-trust__title">Eén duidelijke prijs</p>
        <p class="jr-trust__text">Vooraf weet je precies waar je aan toe bent.</p>
      </article>
      <article class="jr-trust__card">
        <div class="jr-trust__top">
          <span class="jr-trust__index">03</span>
          <span class="jr-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z" />
            </svg>
          </span>
        </div>
        <p class="jr-trust__title">Volledig op maat</p>
        <p class="jr-trust__text">Geen templates. We bouwen het zoals jij het wilt.</p>
      </article>
      <article class="jr-trust__card">
        <div class="jr-trust__top">
          <span class="jr-trust__index">04</span>
          <span class="jr-trust__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 5 6v6c0 5 3.4 8.4 7 9.8 3.6-1.4 7-4.8 7-9.8V6l-7-3Z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </span>
        </div>
        <p class="jr-trust__title">Alles blijft van jou</p>
        <p class="jr-trust__text">Jij houdt de volledige toegang en het eigenaarschap.</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vertrouwen",
  "settings": []
}
{% endschema %}
