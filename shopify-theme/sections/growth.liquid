{%- liquid
  assign ads_link = section.settings.ads_link
  assign automation_link = section.settings.automation_link
  assign apps_link = section.settings.apps_link
  assign websites_link = section.settings.websites_link
  if ads_link == blank
    assign ads_link = '/pages/contact'
  endif
  if automation_link == blank
    assign automation_link = '/pages/contact'
  endif
  if apps_link == blank
    assign apps_link = '/pages/app-laten-bouwen'
  endif
  if websites_link == blank
    assign websites_link = '/pages/webshop-laten-bouwen'
  endif
-%}

<section class="v2-growth">
  <div class="v2-growth__inner page-width">
    <div class="v2-growth__intro">
      <p class="v2-growth__eyebrow"><span></span>{{ section.settings.eyebrow }}</p>
      <h2>
        {%- if section.settings.heading == 'Meer bereik, meer klanten en meetbare online groei' -%}
          <span>Meer bereik, meer klanten en</span>
          <span>meetbare <b>online groei</b></span>
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      <div class="v2-growth__lead">
        {{ section.settings.text }}
      </div>
    </div>

    <div class="v2-growth__cards">
      <article class="v2-growth__card">
        <span class="v2-growth__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <path d="M12 4 5.2 20M12 4l6.8 16M8.1 14.6h7.8"/>
          </svg>
        </span>
        <h3>{{ section.settings.card_one_title }}</h3>
        <p>{{ section.settings.card_one_text }}</p>
        <div class="v2-growth__picture">
          <div class="v2-growth__shot">
            <img src="{{ 'growth-ads.png' | asset_url }}" alt="" width="532" height="208">
          </div>
        </div>
        <a class="v2-growth__more" href="{{ ads_link }}">
          {{ section.settings.more_label }}
          <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="v2-growth__card">
        <span class="v2-growth__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M10.1 2.4h3.8l.5 2.1c.7.2 1.3.5 1.9.9l2-.9 2.7 2.7-1 2c.4.6.7 1.2.9 1.9l2.1.5v3.8l-2.1.5c-.2.7-.5 1.3-.9 1.9l1 2-2.7 2.7-2-.9c-.6.4-1.2.7-1.9.9l-.5 2.1h-3.8l-.5-2.1a7 7 0 0 1-1.9-.9l-2 .9-2.7-2.7 1-2a7 7 0 0 1-.9-1.9l-2.1-.5V9.6l2.1-.5c.2-.7.5-1.3.9-1.9l-1-2 2.7-2.7 2 .9c.6-.4 1.2-.7 1.9-.9l.5-2.1Zm1.9 6.2a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Z"/>
          </svg>
        </span>
        <h3>{{ section.settings.card_two_title }}</h3>
        <p>{{ section.settings.card_two_text }}</p>
        <div class="v2-growth__picture">
          <div class="v2-growth__shot">
            <img src="{{ 'growth-auto.png' | asset_url }}" alt="" width="548" height="208">
          </div>
        </div>
        <a class="v2-growth__more" href="{{ automation_link }}">
          {{ section.settings.more_label }}
          <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="v2-growth__card">
        <span class="v2-growth__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="7" y="3" width="10" height="18" rx="2"/>
            <path d="M11 17.5h2"/>
          </svg>
        </span>
        <h3>{{ section.settings.card_three_title }}</h3>
        <p>{{ section.settings.card_three_text }}</p>
        <div class="v2-growth__picture">
          <div class="v2-growth__shot">
            <img src="{{ 'growth-apps.png' | asset_url }}" alt="" width="490" height="185">
          </div>
        </div>
        <a class="v2-growth__more" href="{{ apps_link }}">
          {{ section.settings.more_label }}
          <span aria-hidden="true">↗</span>
        </a>
      </article>

      <article class="v2-growth__card">
        <span class="v2-growth__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
            <path d="M12 4 4 8l8 4 8-4-8-4Z"/>
            <path d="M4 12l8 4 8-4"/>
            <path d="M4 16l8 4 8-4"/>
          </svg>
        </span>
        <h3>{{ section.settings.card_four_title }}</h3>
        <p>{{ section.settings.card_four_text }}</p>
        <div class="v2-growth__picture">
          <div class="v2-growth__shot">
            <img src="{{ 'growth-shop.png' | asset_url }}" alt="" width="525" height="192">
          </div>
        </div>
        <a class="v2-growth__more" href="{{ websites_link }}">
          {{ section.settings.more_label }}
          <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Online groei",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Online groei"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Meer bereik, meer klanten en meetbare online groei"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Als jouw full-service online marketingpartner combineren we creativiteit, techniek en data voor een aanpak die bij jouw bedrijf past en zichtbaar resultaat oplevert.</p>"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Kaartlink",
      "default": "Meer informatie"
    },
    {
      "type": "text",
      "id": "card_one_title",
      "label": "Kaart 1 titel",
      "default": "Google Ads"
    },
    {
      "type": "textarea",
      "id": "card_one_text",
      "label": "Kaart 1 tekst",
      "default": "Bereik mensen die actief naar jouw aanbod zoeken met doelgerichte campagnes, sterke advertenties en continue optimalisatie."
    },
    {
      "type": "url",
      "id": "ads_link",
      "label": "Kaart 1 link"
    },
    {
      "type": "text",
      "id": "card_two_title",
      "label": "Kaart 2 titel",
      "default": "Automatiseringen"
    },
    {
      "type": "textarea",
      "id": "card_two_text",
      "label": "Kaart 2 tekst",
      "default": "Bespaart tijd en werk door slimme automatiseringen. We koppelen tools, systemen en processen zodat alles vanzelf gaat."
    },
    {
      "type": "url",
      "id": "automation_link",
      "label": "Kaart 2 link"
    },
    {
      "type": "text",
      "id": "card_three_title",
      "label": "Kaart 3 titel",
      "default": "Apps op maat"
    },
    {
      "type": "textarea",
      "id": "card_three_text",
      "label": "Kaart 3 tekst",
      "default": "Van idee tot een gebruiksvriendelijke en krachtige app. Wij ontwikkelen apps die perfect aansluiten op jouw doelen en doelgroep."
    },
    {
      "type": "url",
      "id": "apps_link",
      "label": "Kaart 3 link"
    },
    {
      "type": "text",
      "id": "card_four_title",
      "label": "Kaart 4 titel",
      "default": "Websites & Webshops laten maken"
    },
    {
      "type": "textarea",
      "id": "card_four_text",
      "label": "Kaart 4 tekst",
      "default": "Een snelle, professionele website of webshop die goed vindbaar is en bezoekers overtuigt om contact op te nemen of te kopen."
    },
    {
      "type": "url",
      "id": "websites_link",
      "label": "Kaart 4 link"
    }
  ],
  "presets": [
    {
      "name": "Online groei"
    }
  ]
}
{% endschema %}
