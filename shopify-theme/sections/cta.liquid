<section class="v2-cta">
  <div class="page-width">
    <div class="v2-cta__card">
      <h2>Zullen we <b>kennismaken</b>?</h2>
      <p class="v2-cta__lead">Vertel kort wat je wilt laten bouwen. Een website, webshop, automatisering of app. We horen graag van je!</p>
      <a class="v2-btn v2-btn--solid v2-cta__btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kennismaking",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop",
      "default": "Plan een kennismaking"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knoplink"
    }
  ],
  "presets": [
    {
      "name": "Kennismaking"
    }
  ]
}
{% endschema %}
