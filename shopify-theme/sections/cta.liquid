<section class="v2-cta">
  <svg class="v2-cta__curve v2-cta__curve--right" viewBox="0 0 240 150" fill="none" aria-hidden="true">
    <path d="M8 28C70 8 150 36 232 138" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <svg class="v2-cta__curve v2-cta__curve--left" viewBox="0 0 150 180" fill="none" aria-hidden="true">
    <path d="M130 12C48 48 18 110 78 168" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>

  <div class="page-width">
    <div class="v2-cta__card">
      <h2>Zullen we kennismaken?</h2>
      <p class="v2-cta__lead">Vertel kort wat je wilt laten bouwen. Een website, webshop of app. Of werk dat je nu nog zelf doet.</p>
      <a class="v2-btn v2-btn--solid v2-cta__btn" href="{{ section.settings.button_link | default: '/pages/contact' }}">
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kennismaking",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Knop",
      "default": "Plan een kennismaking"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knoplink"
    }
  ],
  "presets": [
    {
      "name": "Kennismaking"
    }
  ]
}
{% endschema %}
