{% render 'showcase-hero',
  line1: 'Jouw',
  highlight: section.settings.highlight,
  line3: 'klaar om te verkopen',
  description: section.settings.description,
  primary_label: section.settings.primary_label,
  primary_link: section.settings.primary_link
%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Een webshop die overzichtelijk aanvoelt" },
    { "type": "text", "id": "highlight", "label": "Scribble-woord", "default": "webshop" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Tekst",
      "default": "Producten, winkelwagen en checkout. Strak ontwerp, heldere prijzen, klaar om te verkopen."
    },
    { "type": "text", "id": "primary_label", "label": "Knop", "default": "Naar de shop" },
    { "type": "text", "id": "primary_link", "label": "Knop-link", "default": "/collections/all" },
    { "type": "text", "id": "proof", "label": "Regel onder knop", "default": "" },
    { "type": "image_picker", "id": "background_image", "label": "Achtergrond-collage" },
    { "type": "image_picker", "id": "devices_image", "label": "Laptop + telefoon" }
  ]
}
{% endschema %}
