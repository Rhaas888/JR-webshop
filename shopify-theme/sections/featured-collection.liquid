{%- assign featured = section.settings.collection -%}
{%- if featured == blank -%}
  {%- assign featured = collections.all -%}
{%- endif -%}

<section class="jr-section">
  <div class="jr-container">
    {% render 'section-heading',
      kicker: 'Shop',
      title: section.settings.title,
      description: section.settings.description
    %}

    {%- if featured != blank and featured.products_count > 0 -%}
      <div class="jr-product-grid">
        {%- for product in featured.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      <a class="jr-btn jr-btn--ghost" href="{{ featured.url }}">Bekijk de shop</a>
    {%- else -%}
      <p class="jr-lede">Nog geen producten. Voeg ze toe via Shopify Admin → Products; dan staan ze hier.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Uitgelichte collectie",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Onze producten" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Tekst",
      "default": "Overzichtelijk, strak, klaar om te bestellen."
    },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "limit", "min": 3, "max": 12, "step": 1, "label": "Aantal producten", "default": 8 }
  ]
}
{% endschema %}
