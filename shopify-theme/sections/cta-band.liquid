{%- unless page.handle contains 'offerte' -%}
  {% render 'cta-band', title: section.settings.title, text: section.settings.text %}
{%- endunless -%}

{% schema %}
{
  "name": "CTA",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Klaar om te starten?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Vertel kort wat je wilt bouwen. We reageren binnen één werkdag met een voorstel of een paar scherpe vragen."
    }
  ]
}
{% endschema %}
