<section class="jr-section jr-section--muted">
  <div class="jr-container">
    <div class="jr-cta">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="jr-btn jr-btn--light" href="{{ routes.all_products_collection_url }}">Naar de shop</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Klaar om te shoppen?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Bekijk de collectie of neem contact op als je een vraag hebt."
    }
  ]
}
{% endschema %}
