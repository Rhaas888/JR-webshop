{%- unless page.handle contains 'offerte' -%}
  {% render 'page-contact-block',
    kicker: section.settings.kicker,
    title: section.settings.title,
    description: section.settings.description,
    interest: section.settings.interest
  %}
{%- endunless -%}

{% schema %}
{
  "name": "Contactblok",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Contact" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Vertel wat je wilt laten bouwen" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Tekst",
      "default": "Een paar zinnen is genoeg. Binnen 1 werkdag hoor je van ons."
    },
    {
      "type": "select",
      "id": "interest",
      "label": "Standaard interesse",
      "options": [
        { "value": "webshop", "label": "Webshop" },
        { "value": "app", "label": "App" },
        { "value": "onderhoud", "label": "Onderhoud" },
        { "value": "anders", "label": "Anders" }
      ],
      "default": "webshop"
    }
  ]
}
{% endschema %}
