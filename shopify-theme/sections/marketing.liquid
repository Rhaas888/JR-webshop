<section class="v2-market">
  <div class="v2-market__inner page-width">
    <header class="v2-market__head">
      <p class="v2-market__eyebrow"><i></i>{{ section.settings.eyebrow }}</p>
      <h2>
        {%- if section.settings.heading == 'Meer bereik, meer klanten en meetbare online groei' -%}
          Meer <b>bereik</b>, meer <b>klanten</b> en<br>
          <b>meetbare online groei</b>
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      <p class="v2-market__lead">{{ section.settings.text }}</p>
    </header>

    <div class="v2-market__grid">
      <svg class="v2-market__curve v2-market__curve--right" viewBox="0 0 220 360" fill="none" aria-hidden="true">
        <path d="M24 18C110 34 176 108 188 214C198 302 142 346 36 332" stroke="#059B60" stroke-width="1.5"/>
      </svg>
      <svg class="v2-market__curve v2-market__curve--left" viewBox="0 0 200 320" fill="none" aria-hidden="true">
        <path d="M176 16C88 40 22 112 18 198C14 270 72 308 164 296" stroke="#059B60" stroke-width="1.5"/>
      </svg>
      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-fit">
            <div class="v2-fit__board v2-breathe" style="--d: 0s">
              <span class="v2-fit__bar"></span>
              <span class="v2-fit__split"><i></i><i></i></span>
              <span class="v2-fit__bar v2-fit__bar--green"></span>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_one_title }}</h3>
          <p>{{ section.settings.card_one_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-talk">
            <div class="v2-talk__wrap v2-breathe" style="--d: .6s">
              <span class="v2-talk__bubble v2-talk__bubble--them"><i></i><i></i></span>
              <span class="v2-talk__bubble v2-talk__bubble--us"><i></i></span>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_two_title }}</h3>
          <p>{{ section.settings.card_two_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <ul class="v2-list v2-breathe" style="--d: .3s">
            <li><i></i><span></span></li>
            <li><i></i><span></span></li>
            <li><i></i><span></span></li>
          </ul>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_three_title }}</h3>
          <p>{{ section.settings.card_three_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <ol class="v2-path v2-breathe" style="--d: .9s">
            <li>Idee</li>
            <li>Bouwen</li>
            <li>Live</li>
          </ol>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_four_title }}</h3>
          <p>{{ section.settings.card_four_text }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Online marketing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Online marketing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Meer bereik, meer klanten en meetbare online groei"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Als jouw full-service online marketingpartner combineren we creativiteit, techniek en data voor een aanpak die bij jouw bedrijf past en zichtbaar resultaat oplevert."
    },
    {
      "type": "text",
      "id": "card_one_title",
      "label": "Kaart 1 titel",
      "default": "100% maatwerk"
    },
    {
      "type": "textarea",
      "id": "card_one_text",
      "label": "Kaart 1 tekst",
      "default": "We bouwen het zoals jij het nodig hebt. Geen standaardpakket."
    },
    {
      "type": "text",
      "id": "card_two_title",
      "label": "Kaart 2 titel",
      "default": "Persoonlijk contact"
    },
    {
      "type": "textarea",
      "id": "card_two_text",
      "label": "Kaart 2 tekst",
      "default": "Je spreekt direct met ons. Geen loket ertussen."
    },
    {
      "type": "text",
      "id": "card_three_title",
      "label": "Kaart 3 titel",
      "default": "Minder handmatig werk"
    },
    {
      "type": "textarea",
      "id": "card_three_text",
      "label": "Kaart 3 tekst",
      "default": "Taken die je nu zelf doet, laten we voor je lopen."
    },
    {
      "type": "text",
      "id": "card_four_title",
      "label": "Kaart 4 titel",
      "default": "Van idee tot realisatie"
    },
    {
      "type": "textarea",
      "id": "card_four_text",
      "label": "Kaart 4 tekst",
      "default": "Van het eerste idee tot iets dat live staat."
    }
  ],
  "presets": [
    {
      "name": "Online marketing"
    }
  ]
}
{% endschema %}
