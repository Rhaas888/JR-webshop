<section class="v2-market">
  <svg class="v2-market__curve v2-market__curve--right" viewBox="0 0 240 150" fill="none" aria-hidden="true">
    <path d="M8 28C70 8 150 36 232 138" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <svg class="v2-market__curve v2-market__curve--left" viewBox="0 0 150 180" fill="none" aria-hidden="true">
    <path d="M130 12C48 48 18 110 78 168" stroke="#9ed9c0" stroke-width="1.6"/>
  </svg>
  <div class="v2-market__inner page-width">
    <header class="v2-market__head">
      <p class="v2-market__eyebrow"><i></i>{{ section.settings.eyebrow }}</p>
      <h2>
        {%- if section.settings.heading == 'Meer bereik, meer klanten en meetbare online groei' -%}
          Meer <b>bereik</b>, meer <b>klanten</b> en<br>
          <b>meetbare online groei</b>
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h2>
      <p class="v2-market__lead">{{ section.settings.text }}</p>
    </header>

    <div class="v2-market__grid">
      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-ads">
            <div class="v2-ads__night">
              <div class="v2-breathe" style="--d: 0s">
                <p>Campagnes</p>
                <small>Continu geoptimaliseerd</small>
                <strong>24/7</strong>
              </div>
            </div>
            <div class="v2-ads__day">
              <div class="v2-breathe" style="--d: .8s">
                <p class="v2-ads__label">Maandbudget</p>
                <p class="v2-ads__sum">€4.900 <span>/ €10.000</span></p>
                <div class="v2-ads__bar"><i></i></div>
                <div class="v2-ads__row">
                  <span class="v2-ads__ico">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6.5h2.2L9 4.2v7.6L5.2 9.5H3v-3z"/><path d="M10.2 6.2a2.4 2.4 0 0 1 0 3.6"/></svg>
                  </span>
                  <span><b>Google Ads</b><small>Campagne actief</small></span>
                  <em>+ groei</em>
                </div>
                <div class="v2-ads__row">
                  <span class="v2-ads__ico">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="6" cy="8" r="2.2"/><circle cx="11" cy="5" r="1.6"/><circle cx="11" cy="11" r="1.6"/><path d="M8 7.2 9.6 5.8M8 8.8l1.6 1.4"/></svg>
                  </span>
                  <span><b>Social Ads</b><small>Campagne actief</small></span>
                  <em>+ groei</em>
                </div>
                <div class="v2-ads__row">
                  <span class="v2-ads__ico">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.2v5.2l3 1.6"/><circle cx="8" cy="8" r="5.2"/></svg>
                  </span>
                  <span><b>Remarketing</b><small>Campagne actief</small></span>
                  <em>+ groei</em>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_one_title }}</h3>
          <p>{{ section.settings.card_one_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-shot">
            <div class="v2-shot__note">
              <div class="v2-breathe" style="--d: .4s">
                <p>Content die aandacht trekt, jouw merk versterkt en aanzet tot actie</p>
              </div>
            </div>
            <div class="v2-shot__chart">
              <div class="v2-breathe" style="--d: 1.2s">
                <p>Data achter<br>elke keuze</p>
                <div class="v2-bars">
                  <i></i><i></i><i></i><i></i><i></i><i></i><i class="is-hot"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_two_title }}</h3>
          <p>{{ section.settings.card_two_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-social">
            <div class="v2-social__back">
              <div class="v2-breathe" style="--d: .2s">
                <div class="v2-social__people">
                  <span class="v2-avas">
                    <i class="v2-ava v2-ava--a"></i>
                    <i class="v2-ava v2-ava--b"></i>
                    <i class="v2-ava v2-ava--c"></i>
                  </span>
                  <small>250+ merken</small>
                </div>
                <p class="v2-social__script">Zichtbaarheid</p>
              </div>
            </div>
            <div class="v2-social__front">
              <div class="v2-breathe" style="--d: 1s">
                <div class="v2-social__top">
                  <span>Online groei</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12.5 6.2A4.5 4.5 0 1 0 13 9"/><path d="M13 3.5V6.4H10"/></svg>
                </div>
                <p class="v2-social__stat"><strong>49%</strong><em>+2.5%</em></p>
                <div class="v2-social__tags">
                  <span>Bereik</span>
                  <span>Verkeer</span>
                  <span>Leads</span>
                  <span>Omzet</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_three_title }}</h3>
          <p>{{ section.settings.card_three_text }}</p>
        </div>
      </article>

      <article class="v2-market__card">
        <div class="v2-market__stage" aria-hidden="true">
          <div class="v2-radar">
            <span class="v2-radar__ring"></span>
            <span class="v2-radar__ring"></span>
            <span class="v2-radar__ring"></span>
            <div class="v2-radar__core">
              <div class="v2-breathe" style="--d: .6s">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 10-14h-7l0-6z"/></svg>
              </div>
            </div>
            <div class="v2-orbit v2-orbit--search">
              <div class="v2-breathe" style="--d: 0s">
                <i class="v2-ava v2-ava--a"></i>
                <b>Google<br>Search</b>
                <em>+ bereik</em>
              </div>
            </div>
            <div class="v2-orbit v2-orbit--reels">
              <div class="v2-breathe" style="--d: .9s">
                <i class="v2-ava v2-ava--b"></i>
                <b>Instagram<br>Reels</b>
                <em>+ views</em>
              </div>
            </div>
            <div class="v2-orbit v2-orbit--meta">
              <div class="v2-breathe" style="--d: 1.5s">
                <i class="v2-ava v2-ava--c"></i>
                <b>Meta Ads</b>
                <em>+ leads</em>
              </div>
            </div>
          </div>
        </div>
        <div class="v2-market__body">
          <h3>{{ section.settings.card_four_title }}</h3>
          <p>{{ section.settings.card_four_text }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Online marketing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Online marketing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Meer bereik, meer klanten en meetbare online groei"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Als jouw full-service online marketingpartner combineren we creativiteit, techniek en data voor een aanpak die bij jouw bedrijf past en zichtbaar resultaat oplevert."
    },
    {
      "type": "text",
      "id": "card_one_title",
      "label": "Kaart 1 titel",
      "default": "Google Ads"
    },
    {
      "type": "textarea",
      "id": "card_one_text",
      "label": "Kaart 1 tekst",
      "default": "Bereik mensen die actief naar jouw aanbod zoeken met doelgerichte campagnes, sterke advertenties en continue optimalisatie."
    },
    {
      "type": "text",
      "id": "card_two_title",
      "label": "Kaart 2 titel",
      "default": "Short-form videocontent"
    },
    {
      "type": "textarea",
      "id": "card_two_text",
      "label": "Kaart 2 tekst",
      "default": "Val op met korte, krachtige video's voor Instagram, TikTok en YouTube die bereik, herkenning en interactie vergroten."
    },
    {
      "type": "text",
      "id": "card_three_title",
      "label": "Kaart 3 titel",
      "default": "Social media advertenties"
    },
    {
      "type": "textarea",
      "id": "card_three_text",
      "label": "Kaart 3 tekst",
      "default": "Zet Meta en andere sociale kanalen slim in om jouw doelgroep te bereiken, leads te verzamelen en verkopen te stimuleren."
    },
    {
      "type": "text",
      "id": "card_four_title",
      "label": "Kaart 4 titel",
      "default": "Full-service groeistrategie"
    },
    {
      "type": "textarea",
      "id": "card_four_text",
      "label": "Kaart 4 tekst",
      "default": "Verbind je website, SEO, content en paid advertising in één meetbare aanpak die past bij jouw doelen en groeifase."
    }
  ],
  "presets": [
    {
      "name": "Online marketing"
    }
  ]
}
{% endschema %}
