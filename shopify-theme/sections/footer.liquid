{% assign current_year = 'now' | date: '%Y' %}

<footer class="site-footer">
  <div class="site-footer__line" aria-hidden="true"></div>

  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href="{{ routes.root_url }}">
        <img
          src="{{ 'logo-jr.png' | asset_url }}"
          alt="JR Intelligence"
          width="146"
          height="73"
        >
      </a>

      <p class="site-footer__lead">
        Vanuit Reeuwijk bouwen we apps, websites en webshops. En we automatiseren werk dat je nu nog zelf doet.
      </p>

      <ul class="site-footer__meta">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z"/>
            <circle cx="12" cy="11" r="2.1"/>
          </svg>
          <span>Leeghwaterstraat 25<br>2811 DT Reeuwijk<br>Zuid-Holland</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="6" width="17" height="12" rx="2"/>
            <path d="m4 7 8 6 8-6"/>
          </svg>
          <a href="mailto:info@jr-intelligence.com">info@jr-intelligence.com</a>
        </li>
      </ul>

      <form class="site-footer__call" action="/pages/contact" method="get">
        <label class="site-footer__ask" for="FooterPhone">Zullen we je even bellen?</label>
        <div class="site-footer__pill">
          <label class="site-footer__code">
            <span class="site-footer__flag" aria-hidden="true">
              <svg viewBox="0 0 18 12">
                <rect width="18" height="4" fill="#ae1c28"/>
                <rect y="4" width="18" height="4" fill="#fff"/>
                <rect y="8" width="18" height="4" fill="#21468b"/>
              </svg>
            </span>
            <select name="code" aria-label="Landcode">
              <option value="+31">+31</option>
            </select>
            <svg class="site-footer__chev" viewBox="0 0 10 6" aria-hidden="true">
              <path d="M1 1.2 5 4.8 9 1.2"/>
            </svg>
          </label>
          <input
            id="FooterPhone"
            type="tel"
            name="phone"
            inputmode="tel"
            autocomplete="tel-national"
            placeholder="6 12345678"
          >
          <button type="submit">
            Bel ons nu terug
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M7.2 4.5h4.3V8.8"/>
            </svg>
          </button>
        </div>
      </form>

      <div class="site-footer__follow">
        <span>Volg ons</span>
        <a href="/pages/contact" aria-label="TikTok">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6.2c1.1 1.2 2.3 1.8 3.8 2v2.2c-1.4-.1-2.6-.6-3.8-1.5v5.7a4.1 4.1 0 1 1-4.1-4.1c.3 0 .5 0 .8.1v2.2a1.9 1.9 0 1 0 1.3 1.8V5h2z"/></svg>
        </a>
        <a href="/pages/contact" aria-label="Instagram">
          <svg class="is-line" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.3"/><circle cx="16.6" cy="7.4" r="0.8" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="/pages/contact" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 8.2H16V5h-2.4C11.4 5 9.5 6.9 9.5 9.1V11H7.2v2.8h2.3V20h3v-6.2h2.4l.7-2.8h-3.1V9.2c0-.6.4-1 1-1z" stroke="none" fill="currentColor"/></svg>
        </a>
        <a href="/pages/contact" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.6A8.2 8.2 0 0 0 4.9 16l-.8 3.5 3.6-.9A8.2 8.2 0 1 0 12 3.6zm3.7 10.3c-.2.5-1 .9-1.4.9-.4.1-.8.2-2.6-.6-2.2-.9-3.6-3.1-3.7-3.3-.1-.2-.8-1.1-.8-2.1s.5-1.5.7-1.7.4-.3.6-.3h.4c.1 0 .3 0 .5.4.2.4.6 1.4.6 1.5.1.1 0 .3-.1.4l-.3.4c-.1.1-.2.3-.1.5.2.4.7 1.2 1.5 1.9 1 .8 1.8 1.1 2.1 1.2.2.1.4 0 .5-.1l.5-.6c.1-.2.3-.1.5-.1.2.1 1.3.6 1.5.7.2.1.3.2.4.3.1.3.1.7-.1 1z"/></svg>
        </a>
      </div>
    </div>

    <nav class="site-footer__col" aria-label="Diensten">
      <a href="{{ routes.root_url }}">Home</a>
      <a href="/pages/diensten">Alle diensten</a>
      <a href="/pages/app">Apps bouwen</a>
      <a href="/pages/diensten">Websites</a>
      <a href="/pages/webshop">Webshops</a>
      <a href="/pages/diensten">Automatisering</a>
      <a href="/pages/onderhoud">Onderhoud</a>
      <a href="/pages/prijzen">Prijzen</a>
    </nav>

    <nav class="site-footer__col" aria-label="Marketing">
      <a href="/pages/diensten">Short-form video</a>
      <a href="/pages/diensten">Google Ads</a>
      <a href="/pages/diensten">Social media ads</a>
      <a href="/pages/ervaringen">Reviews</a>
    </nav>

    <nav class="site-footer__col" aria-label="Over ons">
      <a href="/pages/over-ons">Over ons</a>
      <a href="/pages/contact">Contact</a>
      <a href="/pages/offerte">Offerte</a>
      <a href="/pages/faq">Veelgestelde vragen</a>
    </nav>

    <div class="site-footer__base">
      <nav class="site-footer__legal" aria-label="Juridisch">
        <a href="/pages/privacy">Privacy</a>
        <a href="/pages/privacy">Cookies</a>
        <a href="/pages/privacy">Cookie-instellingen</a>
      </nav>
      <p>© {{ current_year }} JR Intelligence. Alle rechten voorbehouden.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
