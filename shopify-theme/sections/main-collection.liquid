<section class="jr-section">
  <div class="jr-container">
    <div class="jr-page-intro" style="padding-top: 0;">
      <p class="jr-kicker">Shop</p>
      <h1 class="jr-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="jr-lede">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="jr-product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="jr-pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- else -%}
        <p class="jr-lede">Nog geen producten in deze collectie. Voeg producten toe via Shopify Admin → Products.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collectie",
  "settings": []
}
{% endschema %}
