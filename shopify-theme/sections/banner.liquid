{%- liquid
  assign primary_link = section.settings.primary_link
  assign secondary_link = section.settings.secondary_link
  if primary_link == blank
    assign primary_link = '/pages/contact'
  endif
  if secondary_link == blank
    assign secondary_link = '/pages/diensten'
  endif
-%}

<section class="v2-hero">
  <div class="v2-hero__inner page-width">
    <div class="v2-hero__copy">
      <h1>
        {%- if section.settings.heading == 'Webshop, website, app of automatisering voor jouw bedrijf' -%}
          Webshop, website,<br>
          app of automatisering<br>
          voor jouw bedrijf
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
      <div class="v2-hero__text">
        {%- if section.settings.text contains 'Wij bouwen digitale oplossingen die werken.' -%}
          <p>Wij bouwen digitale oplossingen die werken.<br>Van een professionele webshop tot een slimme app<br>of automatisering van je processen.</p>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </div>
      <div class="v2-hero__actions">
        <a class="v2-btn v2-btn--solid" href="{{ primary_link }}">
          {{ section.settings.primary_label }}
          <span aria-hidden="true">→</span>
        </a>
        <a class="v2-btn v2-btn--line" href="{{ secondary_link }}">
          {{ section.settings.secondary_label }}
        </a>
      </div>
    </div>

    <div class="v2-stage" aria-hidden="true">
      <div class="v2-devices-wrap">
        <img
          class="v2-devices"
          src="{{ 'banner-devices.png' | asset_url }}"
          alt=""
          width="1460"
          height="870"
        >
        <svg class="v2-hero__line" viewBox="0 0 1460 870" fill="none" aria-hidden="true">
          <path d="M 177 377 C 172.5 379.8 158.3 388.5 150 394 C 141.7 399.5 134.0 404.7 127 410 C 120.0 415.3 114.0 420.7 108 426 C 102.0 431.3 96.0 436.7 91 442 C 86.0 447.3 81.8 452.7 78 458 C 74.2 463.3 70.8 468.7 68 474 C 65.2 479.3 62.5 484.7 61 490 C 59.5 495.3 59.3 500.7 59 506 C 58.7 511.3 58.8 516.7 59 522 C 59.2 527.3 59.0 532.7 60 538 C 61.0 543.3 62.0 548.7 65 554 C 68.0 559.3 72.2 564.7 78 570 C 83.8 575.3 84.7 580.3 100 586 C 115.3 591.7 158.3 601.0 170 604" stroke="#059b60" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
          <path d="M 1452 96 C 1445.2 97.7 1423.7 102.7 1411 106 C 1398.3 109.3 1385.2 112.7 1376 116 C 1366.8 119.3 1362.5 122.7 1356 126 C 1349.5 129.3 1342.7 132.7 1337 136 C 1331.3 139.3 1326.7 142.7 1322 146 C 1317.3 149.3 1313.3 152.7 1309 156 C 1304.7 159.3 1300.2 162.7 1296 166 C 1291.8 169.3 1288.0 172.7 1284 176 C 1280.0 179.3 1276.2 182.7 1272 186 C 1267.8 189.3 1263.7 192.7 1259 196 C 1254.3 199.3 1249.0 202.7 1244 206 C 1239.0 209.3 1234.2 212.7 1229 216 C 1223.8 219.3 1218.7 222.7 1213 226 C 1207.3 229.3 1201.5 232.7 1195 236 C 1188.5 239.3 1183.3 242.7 1174 246 C 1164.7 249.3 1144.8 254.3 1139 256" stroke="#059b60" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine tekst",
      "default": "JR Intelligence"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Webshop, website, app of automatisering voor jouw bedrijf"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Wij bouwen digitale oplossingen die werken. Van een professionele webshop tot een slimme app of automatisering van je processen.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primaire knop",
      "default": "Start vandaag"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primaire link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Tweede knop",
      "default": "Bekijk onze diensten"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Tweede link"
    }
  ],
  "presets": [
    {
      "name": "Banner"
    }
  ]
}
{% endschema %}
